# ==============================================================================
# ReVento - Environment Configuration
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe to expose in browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional: Default currency symbol (INR by default, or USD)
VITE_APP_CURRENCY=INR
